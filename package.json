{
    "name": "easy-tikz",
    "version": "4.2.0",
    "description": "Visually design TikZ and pgfplots graphs with a live SVG preview.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && node scripts/build-css.mjs",
        "version": "node version-bump.mjs && git add manifest.json versions.json CHANGELOG.md",
        "test": "node scripts/run-tests.mjs",
        "media:smoke": "node scripts/media/smoke.mjs",
        "media:guides": "node scripts/media/build-guides.mjs",
        "media:promo": "node scripts/media/build-promo.mjs",
        "media:video": "node scripts/media/build-video.mjs",
        "media:brand": "node scripts/media/brand/build.mjs",
        "media:film": "node scripts/media/cinema/build.mjs"
    },
    "keywords": [
        "obsidian",
        "plugin",
        "tikz",
        "pgfplots",
        "graph",
        "latex",
        "math",
        "renderer",
        "visualization"
    ],
    "author": "Saiki77",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^16.11.6",
        "@typescript-eslint/eslint-plugin": "^5.2.0",
        "@typescript-eslint/parser": "^5.2.0",
        "esbuild": "0.13.12",
        "obsidian": "^1.13.1",
        "tslib": "2.3.1",
        "typescript": "^5.9.3"
    }
}
